rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* Gallery hearts: a signed-in client may only move a count by 1. */
    match /votes/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && (request.resource.data.count == resource.data.count + 1
            || request.resource.data.count == resource.data.count - 1);
    }

    /* One row per participant, keyed by the 5-digit ID (see shared/store.js).
       - The selection screen creates it once. An ID that already exists cannot be created again.
       - Any signed-in station can read a row by its ID, and list the newest rows (the result
         station's search list). A list query must carry limit(300) or less.
       - Clients cannot edit or delete a row. Stations that add to it (photo and voice,
         generation) either use the admin SDK from a server, which is not subject to these rules,
         or get their own update rule added here. */
    match /participants/{id} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 300;
      allow update, delete: if false;

      allow create: if request.auth != null
        && id.matches('[1-9][0-9]{4}')
        && request.resource.data.keys().hasOnly(
             ['name', 'dance', 'hair', 'outfit', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 14
        && request.resource.data.dance is string && request.resource.data.dance.size() <= 20
        && request.resource.data.hair is string && request.resource.data.hair.size() <= 20
        && request.resource.data.outfit is string && request.resource.data.outfit.size() <= 20
        && request.resource.data.status == 'created'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }
  }
}
